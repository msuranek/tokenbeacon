{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.mts",
    "tests/**/*.ts",
    "bench/**/*.ts",
    "scripts/**/*.ts"
  ]
}
